{
  "$defs": {
    "AnnotatorRole": {
      "enum": [
        "INDEPENDENT_ANNOTATOR",
        "LEAD_ARBITRATOR",
        "AUDITOR"
      ],
      "title": "AnnotatorRole",
      "type": "string"
    },
    "CitationStatus": {
      "enum": [
        "AUTHORITATIVE_SUPPORTING",
        "RELEVANT_SUPPORTING",
        "IRRELEVANT",
        "CONTRADICTING",
        "FABRICATED_UNREACHABLE"
      ],
      "title": "CitationStatus",
      "type": "string"
    },
    "ClaimVerdict": {
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "UNSUPPORTED",
        "GENUINELY_UNSCORABLE"
      ],
      "title": "ClaimVerdict",
      "type": "string"
    },
    "CompletedCitationEvaluation": {
      "properties": {
        "citation_url_or_domain": {
          "description": "URL or domain string extracted from response",
          "minLength": 1,
          "title": "Citation Url Or Domain",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CitationStatus",
          "description": "Classification of citation authenticity and support"
        },
        "is_authoritative": {
          "description": "True if domain is an official .gov.in or statutory portal",
          "title": "Is Authoritative",
          "type": "boolean"
        },
        "backed_claim_ids": {
          "description": "Claims supported by this citation",
          "items": {
            "type": "string"
          },
          "title": "Backed Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "citation_url_or_domain",
        "status",
        "is_authoritative"
      ],
      "title": "CompletedCitationEvaluation",
      "type": "object"
    },
    "CompletedClaimAnnotation": {
      "properties": {
        "claim_id": {
          "description": "Stable unique claim ID within response",
          "pattern": "^CLAIM_\\d+$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "description": "Extracted atomic claim statement",
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ClaimVerdict",
          "description": "Adjudicated claim verdict"
        },
        "matched_fact_ids": {
          "description": "IDs of ground-truth benchmark facts matched",
          "items": {
            "type": "string"
          },
          "title": "Matched Fact Ids",
          "type": "array"
        },
        "rationale": {
          "description": "Justification grounded strictly in benchmark evidence",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "verdict",
        "rationale"
      ],
      "title": "CompletedClaimAnnotation",
      "type": "object"
    },
    "CompletedFactCoverage": {
      "properties": {
        "fact_id": {
          "description": "Benchmark Fact ID (e.g. CF1, CF2)",
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FactCoverageStatus",
          "description": "Coverage status relative to candidate response"
        },
        "supporting_claim_ids": {
          "description": "List of claim IDs supporting this fact",
          "items": {
            "type": "string"
          },
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "",
          "description": "Optional explanation for partial coverage or omission",
          "title": "Rationale"
        }
      },
      "required": [
        "fact_id",
        "status"
      ],
      "title": "CompletedFactCoverage",
      "type": "object"
    },
    "CompletedImportantFactCoverage": {
      "properties": {
        "fact_id": {
          "description": "Benchmark Important Fact ID (e.g. IF1, IF2)",
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FactCoverageStatus",
          "description": "Coverage status"
        },
        "supporting_claim_ids": {
          "description": "List of supporting claim IDs",
          "items": {
            "type": "string"
          },
          "title": "Supporting Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "status"
      ],
      "title": "CompletedImportantFactCoverage",
      "type": "object"
    },
    "CompletedItemAnnotation": {
      "properties": {
        "item_index": {
          "description": "0-indexed position in validation sample",
          "minimum": 0,
          "title": "Item Index",
          "type": "integer"
        },
        "response_id": {
          "description": "Frozen response ID",
          "pattern": "^resp_[a-f0-9]{12}$",
          "title": "Response Id",
          "type": "string"
        },
        "task_id": {
          "description": "Benchmark Task ID",
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "annotator_id": {
          "description": "Identifier of human annotator or arbitrator",
          "minLength": 1,
          "title": "Annotator Id",
          "type": "string"
        },
        "timestamp_utc": {
          "description": "ISO 8601 timestamp of annotation completion",
          "minLength": 10,
          "title": "Timestamp Utc",
          "type": "string"
        },
        "rubric_version": {
          "description": "Rubric version applied (e.g. 12.5.2D)",
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "extracted_claims": {
          "description": "List of all extracted atomic claims and their adjudications",
          "items": {
            "$ref": "#/$defs/CompletedClaimAnnotation"
          },
          "title": "Extracted Claims",
          "type": "array"
        },
        "critical_facts_coverage": {
          "description": "Coverage adjudications for each benchmark Critical Fact",
          "items": {
            "$ref": "#/$defs/CompletedFactCoverage"
          },
          "minItems": 1,
          "title": "Critical Facts Coverage",
          "type": "array"
        },
        "important_facts_coverage": {
          "description": "Coverage adjudications for benchmark Important Facts",
          "items": {
            "$ref": "#/$defs/CompletedImportantFactCoverage"
          },
          "title": "Important Facts Coverage",
          "type": "array"
        },
        "citations_evaluation": {
          "description": "Adjudications of all citations in response",
          "items": {
            "$ref": "#/$defs/CompletedCitationEvaluation"
          },
          "title": "Citations Evaluation",
          "type": "array"
        },
        "m5_composite_citation_grade": {
          "description": "Composite Citation Quality grade (0-4)",
          "maximum": 4,
          "minimum": 0,
          "title": "M5 Composite Citation Grade",
          "type": "integer"
        },
        "m6_domain_safety_rating": {
          "description": "Domain safety level (0: Safe, 1: Minor, 2: Critical)",
          "maximum": 2,
          "minimum": 0,
          "title": "M6 Domain Safety Rating",
          "type": "integer"
        },
        "m7_semantic_preservation_grade": {
          "description": "UIN-anchored semantic preservation grade (0-4)",
          "maximum": 4,
          "minimum": 0,
          "title": "M7 Semantic Preservation Grade",
          "type": "integer"
        },
        "annotator_comments": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "",
          "description": "Optional annotator notes",
          "title": "Annotator Comments"
        }
      },
      "required": [
        "item_index",
        "response_id",
        "task_id",
        "annotator_id",
        "timestamp_utc",
        "rubric_version",
        "extracted_claims",
        "critical_facts_coverage",
        "m5_composite_citation_grade",
        "m6_domain_safety_rating",
        "m7_semantic_preservation_grade"
      ],
      "title": "CompletedItemAnnotation",
      "type": "object"
    },
    "FactCoverageStatus": {
      "enum": [
        "COVERED",
        "PARTIALLY_COVERED",
        "OMITTED",
        "CONTRADICTED"
      ],
      "title": "FactCoverageStatus",
      "type": "string"
    }
  },
  "properties": {
    "submission_id": {
      "description": "Unique batch submission identifier",
      "minLength": 1,
      "title": "Submission Id",
      "type": "string"
    },
    "annotator_id": {
      "description": "Annotator identifier",
      "minLength": 1,
      "title": "Annotator Id",
      "type": "string"
    },
    "annotator_role": {
      "$ref": "#/$defs/AnnotatorRole",
      "description": "Role of submitting agent"
    },
    "rubric_version": {
      "default": "12.5.2D",
      "description": "Rubric version",
      "title": "Rubric Version",
      "type": "string"
    },
    "created_at_utc": {
      "description": "ISO 8601 completion timestamp",
      "minLength": 10,
      "title": "Created At Utc",
      "type": "string"
    },
    "sample_hash_sha256": {
      "description": "SHA-256 hash of validated response IDs",
      "minLength": 64,
      "title": "Sample Hash Sha256",
      "type": "string"
    },
    "total_items": {
      "description": "Total number of annotated items in submission",
      "minimum": 1,
      "title": "Total Items",
      "type": "integer"
    },
    "records": {
      "description": "List of completed item annotations",
      "items": {
        "$ref": "#/$defs/CompletedItemAnnotation"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "submission_id",
    "annotator_id",
    "annotator_role",
    "created_at_utc",
    "sample_hash_sha256",
    "total_items",
    "records"
  ],
  "title": "CompletedAnnotationSubmission",
  "type": "object"
}