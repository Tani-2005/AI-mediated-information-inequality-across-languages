# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# English-Hindi AI-Mediated Information Seeking Experiment (Protocol v1.1.0)
# ==============================================================================
# COPY THIS FILE TO `.env` AND FILL IN YOUR LOCAL RESEARCH CONFIGURATION.
# DO NOT COMMIT ACTUAL PASSWORDS OR API KEYS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development' for local mocking/testing.
# Set to 'production' for Local Research Participant Data Collection.
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. LOCAL POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development SQLite Default:
DATABASE_URL=sqlite:///./backend/experiment.db

# Local Research Deployment PostgreSQL Connection Format (REQUIRED FOR RESEARCH):
# DATABASE_URL=postgresql://exp_user:YOUR_LOCAL_DB_PASSWORD@localhost:5432/ai_info_inequality_db

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API CONFIGURATION (FROZEN MODEL: gemini-3.5-flash)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 4. MOCK & EXPERIMENTAL SWITCHES
# ------------------------------------------------------------------------------
# Set USE_MOCK_LLM=true for synthetic testing without API calls.
# MUST BE SET TO false FOR LOCAL RESEARCH PARTICIPANT DATA COLLECTION.
USE_MOCK_LLM=true
LLM_ENABLED=true
IS_PILOT_MODE=false
MAX_SESSION_COUNT=200
MAX_API_CALLS_PER_SESSION=30

# ------------------------------------------------------------------------------
# 5. LOCAL CORS & SECURITY HARDENING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO WILDCARDS in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting for public session endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# Administrative API Key for protecting /api/v1/admin/* endpoints
ADMIN_API_KEY=YOUR_STRONG_LOCAL_ADMIN_KEY_HERE

# ------------------------------------------------------------------------------
# 6. OPENAI FALLBACK CONFIGURATION (UNSUCCESSFUL/DISABLED IN PROTOCOL V1.1.0)
# ------------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_API_KEY=
